{
  "id": "write-barrier",
  "request": "Read state.txt, write the new state, then read it again in one turn.",
  "repo_files": ["state.txt"],
  "permission_mode": "auto",
  "responses": [
    {
      "tool_calls": [
        {"id": "read-before", "name": "read_file", "arguments": {"file_path": "state.txt"}},
        {"id": "write-middle", "name": "write_file", "arguments": {"file_path": "state.txt", "content": "new\n"}},
        {"id": "read-after", "name": "read_file", "arguments": {"file_path": "state.txt"}}
      ],
      "prompt_tokens": 12,
      "completion_tokens": 4
    },
    {"content": "write barrier complete", "prompt_tokens": 8, "completion_tokens": 3}
  ],
  "expected": {
    "final_answer": "write barrier complete",
    "files_equal": {"state.txt": "new\n"},
    "tool_events": [
      {"tool_name": "read_file", "status": "ok"},
      {"tool_name": "write_file", "status": "ok"},
      {"tool_name": "read_file", "status": "ok"}
    ]
  }
}
